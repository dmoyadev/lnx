{
  "name": "lnxjs",
  "version": "0.7.11",
  "description": "Lynx Library",
  "author": "Daniel Moya",
  "workspaces": [
    "packages/*",
    "sandbox"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dmoyadev/lnx"
  },
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "pnpm --filter \"sandbox\" dev",
    "create-component": "node scripts/create-component/create-component.js",
    "build": "pnpm -r build",
    "version": "pnpm -r version",
    "check-typing": "vue-tsc --noEmit && vue-tsc --noEmit -p packages/components && eslint .",
    "lint:fix": "eslint --fix",
    "check-deps": "npx npm-check -u",
    "create-release": "pnpm build && pnpm publish --filter \"lnxjs-*\"",
    "release:patch": "pnpm version patch && pnpm create-release",
    "release:minor": "pnpm version minor && pnpm create-release",
    "release:major": "pnpm version major && pnpm create-release",
    "docs:dev": "vitepress dev --port 9998",
    "docs:build": "vitepress build"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/eslint-config-typescript": "14.9.0",
    "auto-changelog": "^2.7.0",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.0",
    "postcss": "^8.5.32",
    "sass": "1.107.1",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitepress": "1.6.4",
    "vitepress-plugin-group-icons": "1.8.1",
    "vue": "3.5.44",
    "vue-tsc": "3.3.14"
  },
  "engines": {
    "node": ">=22.7.0",
    "pnpm": ">=9.4.0",
    "npm": "please-use-pnpm",
    "yarn": "please-use-pnpm"
  }
}
