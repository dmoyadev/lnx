{
	"extends": "../../tsconfig.json",

	"include": [
		"vue-shim.d.ts",
		"src/**/*",
		"src/**/*.ts",
		"src/**/*.vue"
	],

	"exclude": [
		"**/*.md",
		"**/docs.ts"
	],

	"compilerOptions": {
		"rootDir": "./src",
		"types": ["vite/client"], // declares style imports such as the theme .scss
		"declarationDir": "./dist/types"
	}
}